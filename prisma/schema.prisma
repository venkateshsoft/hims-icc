generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CLOSED
}
enum ChecklistStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  PENDING_REVIEW
  COMPLETED
  REJECTED
  NOT_APPLICABLE
}
enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

model Organization {
  id String @id @default(uuid())
  name String
  type String
  country String
  state String?
  city String?
  hospitalsCount Int @default(0)
  facilitiesCount Int @default(0)
  beds Int @default(0)
  opdDepartments Int @default(0)
  ipdDepartments Int @default(0)
  operatingTheatres Int @default(0)
  employees Int @default(0)
  doctors Int @default(0)
  nurses Int @default(0)
  administrativeUsers Int @default(0)
  avgDailyOpd Int @default(0)
  avgDailyIpd Int @default(0)
  avgDailyRegistrations Int @default(0)
  avgDailyBillingTransactions Int @default(0)
  implementationObjectives String[] @default([])
  deploymentModel String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  hospitals Hospital[]
  projects ImplementationProject[]
  assessments OrganizationAssessment[]
  gaps Gap[]
  moduleScopes ModuleScope[]
  auditLogs AuditLog[]
  requirements Requirement[]
  defects Defect[]
  evidence Evidence[]
  approvals Approval[]
  goLiveAssessments GoLiveAssessment[]
  hypercareIncidents HypercareIncident[]
  @@index([name])
  @@unique([name])
}

model Hospital {
  id String @id @default(uuid())
  organizationId String
  name String
  city String?
  beds Int @default(0)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  facilities Facility[]
  @@index([organizationId])
}

model Facility {
  id String @id @default(uuid())
  hospitalId String
  name String
  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  departments Department[]
  @@index([hospitalId])
}

model Department {
  id String @id @default(uuid())
  facilityId String
  name String
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  @@index([facilityId])
}

model ImplementationProject {
  id String @id @default(uuid())
  organizationId String
  name String
  status ProjectStatus @default(PLANNING)
  targetGoLive DateTime?
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  phases ProjectPhase[]
  tasks ProjectTask[]
  checklistItems ChecklistItem[]
  risks Risk[]
  testPlans TestPlan[]
  gaps Gap[]
  requirements Requirement[]
  goLiveAssessments GoLiveAssessment[]
  hypercareIncidents HypercareIncident[]
  @@index([organizationId, status])
}

model ProjectPhase {
  id String @id @default(uuid())
  projectId String
  name String
  sortOrder Int
  progress Int @default(0)
  project ImplementationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([projectId, sortOrder])
}

model ProjectTask {
  id String @id @default(uuid())
  projectId String
  title String
  owner String?
  status String
  dueDate DateTime?
  project ImplementationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([projectId, status])
}

model HIMSModule {
  id String @id @default(uuid())
  key String @unique
  name String
  domain String
  description String
  dependencies String[] @default([])
  scopes ModuleScope[]
  questions AssessmentQuestion[]
}

model ModuleScope {
  id String @id @default(uuid())
  organizationId String
  moduleId String
  state String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  module HIMSModule @relation(fields: [moduleId], references: [id])
  @@unique([organizationId, moduleId])
  @@index([organizationId, state])
}

model AssessmentQuestion {
  id String @id @default(uuid())
  key String @unique
  moduleId String?
  category String
  prompt String
  helpText String?
  weight Float @default(1)
  critical Boolean @default(false)
  module HIMSModule? @relation(fields: [moduleId], references: [id])
  responses AssessmentResponse[]
  @@index([moduleId, category])
}

model OrganizationAssessment {
  id String @id @default(uuid())
  organizationId String
  version String
  score Float?
  criticalBlockers Int @default(0)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  responses AssessmentResponse[]
  @@index([organizationId])
}

model AssessmentResponse {
  id String @id @default(uuid())
  assessmentId String
  questionId String
  questionKey String
  answer String
  comment String?
  evidenceRef String?
  assessment OrganizationAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question AssessmentQuestion @relation(fields: [questionId], references: [id])
  @@unique([assessmentId, questionId])
  @@index([assessmentId, answer])
}

model Gap {
  id String @id @default(uuid())
  organizationId String
  projectId String?
  questionKey String?
  title String
  severity Severity
  currentState String
  desiredState String
  businessImpact String
  recommendedSolution String
  owner String?
  status String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project ImplementationProject? @relation(fields: [projectId], references: [id])
  @@index([organizationId, severity, status])
}

model ChecklistItem {
  id String @id @default(uuid())
  projectId String
  title String
  category String
  owner String?
  priority Severity
  status ChecklistStatus @default(NOT_STARTED)
  dueDate DateTime?
  project ImplementationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([projectId, status])
}

model Risk {
  id String @id @default(uuid())
  projectId String
  title String
  category String
  severity Severity
  owner String?
  status String
  mitigation String?
  project ImplementationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([projectId, severity, status])
}

model TestPlan {
  id String @id @default(uuid())
  projectId String
  name String
  project ImplementationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testCases TestCase[]
  @@index([projectId])
}

model TestCase {
  id String @id @default(uuid())
  testPlanId String
  key String
  title String
  workflow String
  requirementId String?
  testPlan TestPlan @relation(fields: [testPlanId], references: [id], onDelete: Cascade)
  requirement Requirement? @relation(fields: [requirementId], references: [id])
  executions TestExecution[]
  @@unique([testPlanId, key])
}

model Requirement {
  id String @id @default(uuid())
  organizationId String
  projectId String?
  key String
  title String
  description String
  category String
  priority Severity
  status String @default("DRAFT")
  designReference String?
  configurationReference String?
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project ImplementationProject? @relation(fields: [projectId], references: [id])
  testCases TestCase[]
  evidence Evidence[]
  approvals Approval[]
  defects Defect[]
  @@unique([organizationId, key])
  @@index([organizationId, status])
}

model TestExecution {
  id String @id @default(uuid())
  testCaseId String
  result String
  tester String
  executedAt DateTime @default(now())
  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  defects Defect[]
  evidence Evidence[]
  @@index([testCaseId, result])
}

model Defect {
  id String @id @default(uuid())
  organizationId String
  projectId String?
  requirementId String?
  testExecutionId String?
  key String
  title String
  description String
  severity Severity
  status String @default("OPEN")
  owner String?
  resolution String?
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  testExecution TestExecution? @relation(fields: [testExecutionId], references: [id])
  requirement Requirement? @relation(fields: [requirementId], references: [id])
  evidence Evidence[]
  @@unique([organizationId, key])
  @@index([organizationId, severity, status])
}

model Evidence {
  id String @id @default(uuid())
  organizationId String
  entityType String
  entityId String
  title String
  uri String?
  notes String?
  uploadedBy String
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requirement Requirement? @relation(fields: [requirementId], references: [id])
  testExecution TestExecution? @relation(fields: [testExecutionId], references: [id])
  defect Defect? @relation(fields: [defectId], references: [id])
  requirementId String?
  testExecutionId String?
  defectId String?
  @@index([organizationId, entityType, entityId])
}

model Approval {
  id String @id @default(uuid())
  organizationId String
  requirementId String?
  goLiveAssessmentId String?
  type String
  status String @default("PENDING")
  approver String
  decisionReason String?
  evidenceId String?
  expiresAt DateTime?
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requirement Requirement? @relation(fields: [requirementId], references: [id])
  goLiveAssessment GoLiveAssessment? @relation(fields: [goLiveAssessmentId], references: [id])
  @@index([organizationId, type, status])
}

model GoLiveAssessment {
  id String @id @default(uuid())
  organizationId String
  projectId String?
  decision String @default("NOT_READY")
  migrationReconciled Boolean @default(false)
  cutoverPlanApproved Boolean @default(false)
  evaluatedAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project ImplementationProject? @relation(fields: [projectId], references: [id])
  gates GoLiveGate[]
  approvals Approval[]
  exceptions GoLiveException[]
  @@index([organizationId, decision, evaluatedAt])
}

model GoLiveGate {
  id String @id @default(uuid())
  assessmentId String
  code String
  label String
  mandatory Boolean @default(true)
  passed Boolean
  detail String
  assessment GoLiveAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  @@unique([assessmentId, code])
}

model GoLiveException {
  id String @id @default(uuid())
  assessmentId String
  title String
  justification String
  approver String
  status String @default("PENDING")
  reviewDate DateTime
  assessment GoLiveAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  @@index([assessmentId, status])
}

model HypercareIncident {
  id String @id @default(uuid())
  organizationId String
  projectId String?
  key String
  title String
  description String
  severity Severity
  status String @default("OPEN")
  owner String?
  slaDueAt DateTime?
  resolvedAt DateTime?
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project ImplementationProject? @relation(fields: [projectId], references: [id])
  @@unique([organizationId, key])
  @@index([organizationId, severity, status])
}

model AuditLog {
  id String @id @default(uuid())
  organizationId String
  actorId String?
  action String
  entityType String
  entityId String
  metadata Json?
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId, createdAt])
}
